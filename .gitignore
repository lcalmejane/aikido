# Ignore all .DS_Store files regardless of depth
**/.DS_Store
prompts/spec/
spec/
!distribution/templates/project/prompts/spec/
/dist/
prompts/hard_points/system/structure/indices
prompts/hard_points/system/structure/index.json
prompts/hard_points/system/structure/index.json
.claude/worktrees
.claude/worktrees/*

# Private Task Store data must never enter source control.
**/.private/
**/.task-store/
**/aikido/tasks/
**/.aikido/tasks/


# Secrets / local configuration (never commit)
prompts/hard_points/configuration/*.local.cfg
.env
.env.*
*.pem
*.key
.claude/settings.local.json
*.local.*
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json

# Generated host packages shipped in the npm package
distribution/npm/packages/
distribution/npm/LICENSE
