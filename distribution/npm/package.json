{
  "name": "@aikido-method/cli",
  "version": "1.5.4",
  "description": "Install, update and synchronise the AI-KIDO Memory Bank for every assistant CLI installed on the machine.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./task-store": {
      "types": "./lib/task-store/index.d.ts",
      "import": "./lib/task-store/index.mjs"
    },
    "./*": "./*"
  },
  "bin": {
    "aikido": "bin/aikido.mjs"
  },
  "files": [
    "bin",
    "lib",
    "packages",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcalmejane/aikido.git",
    "directory": "distribution/npm"
  },
  "keywords": ["aikido", "memory-bank", "claude-code", "codex", "copilot", "kiro", "roo-code", "agents"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node scripts/prepack.mjs"
  }
}
